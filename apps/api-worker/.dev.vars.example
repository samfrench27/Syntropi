HOSTED_PAGES_JWT_SECRET=
TOKEN_WEBHOOK_SECRET=
# Connection string for the restricted api_worker role (Supabase pooler, session mode)
WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
