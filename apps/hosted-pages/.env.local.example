# Copy to .env.local. NEXT_PUBLIC_* values are baked into the static export at build time.

# Base URL of the Syntropi API Worker (paths start with /api/...).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# Local design work without an API: shows fictional data instead of calling the API. Never set in production.
# NEXT_PUBLIC_USE_MOCK_DATA=true
