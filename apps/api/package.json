{
  "name": "api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node dist/server.js",
    "dev": "nodemon",
    "build": "tsc",
    "docs:build": "redocly build-docs docs/openapi.yaml -o docs/build/index.html",
    "docs:serve": "redocly preview-docs docs/openapi.yaml",
    "docs:lint": "redocly lint docs/openapi.yaml",
    "docs:bundle": "redocly bundle docs/openapi.yaml -o docs/dist/openapi.yaml",
    "docs:static": "npx http-server docs/build -o -p 8081",
    "docs:generate-client": "npx openapi-typescript-codegen --input docs/openapi.yaml --output docs/client"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.8.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.477.0",
    "mongodb": "^6.15.0",
    "mongoose": "^8.3.4",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@redocly/cli": "^1.9.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.8",
    "nodemon": "^3.1.9",
    "openapi-typescript-codegen": "^0.28.0",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
