# Stripe Environment Variables Template
# Copy this to your .env files and replace with your actual Stripe keys

# ========================================
# API SERVER (.env)
# ========================================

# Stripe Secret Key (Server-side only)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Endpoint Secret (for webhook signature verification)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Product/Price IDs for subscription plans
STRIPE_STARTER_PRICE_ID=price_starter_plan_id
STRIPE_GROWTH_PRICE_ID=price_growth_plan_id  
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_plan_id

# ========================================
# ADMIN DASHBOARD (.env.local)
# ========================================

# Stripe Publishable Key (Client-side safe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ========================================
# HOW TO GET THESE VALUES:
# ========================================

# 1. Go to https://dashboard.stripe.com/
# 2. Create a Stripe account or log in
# 3. Switch to "Test mode" in the top right
# 4. Go to "Developers" > "API keys" to get:
#    - Publishable key (pk_test_...)
#    - Secret key (sk_test_...)
# 5. Create subscription products:
#    - Go to "Products" > "Create product"
#    - Create three products: Starter, Growth, Enterprise
#    - Set up recurring pricing for each
#    - Copy the price IDs (price_...)
# 6. For webhooks (optional for development):
#    - Go to "Developers" > "Webhooks"
#    - Add endpoint: http://your-domain/api/webhooks/stripe
#    - Select events: customer.subscription.created, customer.subscription.updated, customer.subscription.deleted, invoice.payment_succeeded, invoice.payment_failed
#    - Copy the webhook signing secret (whsec_...)

